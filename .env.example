# Environment Variables for Yarvo Hotel System

# Database
POSTGRES_PASSWORD=strong_secure_password
DATABASE_URL="postgresql://postgres:strong_secure_password@postgres:5432/yarvo_db?schema=public"

# Authentication
# Generate a strong, secure random string for JWT_SECRET
JWT_SECRET=super_secret_jwt_key_here

# Frontend Configuration
# Replace with the actual domain or IP address of your VPS where the API will be accessible
NEXT_PUBLIC_API_URL="http://yourdomain.com:3002"
# Alternatively, if you are setting up an Nginx reverse proxy routing `/api` to port 3002:
# NEXT_PUBLIC_API_URL="http://yourdomain.com/api"
