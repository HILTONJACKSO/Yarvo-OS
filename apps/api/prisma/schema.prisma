generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  fullName           String
  email              String    @unique
  phone              String?
  passwordHash       String
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  status             String    @default("ACTIVE")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  businesses               BusinessMember[]
  sessions                 RefreshSession[]
  employeeRecords          Employee[]
  createdCustomers         Customer[]         @relation("CustomerCreatedBy")
  createdCustomerNotes     CustomerNote[]     @relation("NoteCreatedBy")
  blockedCustomers         CustomerBlock[]    @relation("BlockBlockedBy")
  unblockedCustomers       CustomerBlock[]    @relation("BlockUnblockedBy")
  createdGroups            CustomerGroup[]    @relation("GroupCreatedBy")
  createdCorporateAccounts CorporateAccount[] @relation("CorporateCreatedBy")

  // Reservations & Availability
  createdReservations   Reservation[]         @relation("ReservationCreatedBy")
  confirmedReservations Reservation[]         @relation("ReservationConfirmedBy")
  cancelledReservations Reservation[]         @relation("ReservationCancelledBy")
  receivedDeposits      ReservationDeposit[]  @relation("DepositReceivedBy")
  createdRoomBlocks     RoomBlock[]           @relation("RoomBlockCreatedBy")
  cancelledRoomBlocks   RoomBlock[]           @relation("RoomBlockCancelledBy")
  reservationHistory    ReservationHistory[]  @relation("HistoryChangedBy")
  createdWaitlists      ReservationWaitlist[] @relation("WaitlistCreatedBy")

  // Stays & Folios
  checkedInStays        Stay[]               @relation("StayCheckedInBy")
  checkoutPreparedStays Stay[]               @relation("StayCheckoutPreparedBy")
  stayRoomAssignments   StayRoomAssignment[] @relation("StayRoomAssignedBy")
  postedFolioEntries    FolioEntry[]         @relation("FolioEntryPostedBy")
  voidedFolioEntries    FolioEntry[]         @relation("FolioEntryVoidedBy")
  createdGuestRequests  GuestRequest[]       @relation("GuestRequestCreatedBy")
  stayHistories         StayHistory[]        @relation("StayHistoryChangedBy")

  // CRM
  createdTimelines          CustomerTimeline[]      @relation("TimelineCreatedBy")
  verifiedDocuments         CustomerDocument[]      @relation("DocumentVerifiedBy")
  assignedComplaints        CustomerComplaint[]     @relation("ComplaintAssignedTo")
  sentCommunications        CustomerCommunication[] @relation("CommunicationSentBy")
}

model Business {
  id        String   @id @default(uuid())
  name      String
  type      String
  country   String
  currency  String
  phone     String
  email     String
  address   String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        BusinessMember[]
  branches       Branch[]
  departments    Department[]
  roles          Role[]
  employees      Employee[]
  activities     UserActivity[]
  branchServices BranchService[]
  propertyAreas  PropertyArea[]
  roomTypes      RoomType[]
  rooms          Room[]
  seatingAreas   SeatingArea[]
  serviceTables  ServiceTable[]
  servicePoints  ServicePoint[]
  beachResources BeachResource[]
  pools          SwimmingPool[]
  eventSpaces    EventSpace[]
  operatingHours OperatingHour[]

  customers               Customer[]
  customerLabels          CustomerLabel[]
  customerIdentifications CustomerIdentification[]
  customerPreferences     CustomerPreference[]
  customerNotes           CustomerNote[]
  customerBlocks          CustomerBlock[]
  customerVisits          CustomerVisit[]
  customerGroups          CustomerGroup[]
  corporateAccounts       CorporateAccount[]

  // Reservations & Availability
  reservations          Reservation[]
  reservationRooms      ReservationRoom[]
  reservationGuests     ReservationGuest[]
  reservationDeposits   ReservationDeposit[]
  roomBlocks            RoomBlock[]
  reservationHistories  ReservationHistory[]
  reservationWaitlists  ReservationWaitlist[]
  onlineBookingRequests OnlineBookingRequest[]

  // Stays & Folios
  stays                       Stay[]
  stayRoomAssignments         StayRoomAssignment[]
  stayOccupants               StayOccupant[]
  guestFolios                 GuestFolio[]
  folioEntries                FolioEntry[]
  guestRequests               GuestRequest[]
  stayHistories               StayHistory[]
  CatalogCategory             CatalogCategory[]
  CatalogItem                 CatalogItem[]
  CatalogItemBranch           CatalogItemBranch[]
  CatalogItemServicePoint     CatalogItemServicePoint[]
  CatalogItemVariation        CatalogItemVariation[]
  ModifierGroup               ModifierGroup[]
  ModifierOption              ModifierOption[]
  Menu                        Menu[]
  CatalogAvailabilitySchedule CatalogAvailabilitySchedule[]
  PriceList                   PriceList[]
  Package                     Package[]
  CatalogDietaryTag           CatalogDietaryTag[]
  CatalogAllergen             CatalogAllergen[]

  orders                      Order[]                       @relation("BusinessOrders")
  preparationStations         PreparationStation[]          @relation("BusinessPrepStations")
  taxRules                    TaxRule[]                     @relation("BusinessTaxRules")
  serviceChargeRules          ServiceChargeRule[]           @relation("BusinessServiceChargeRules")
}

model BusinessMember {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       String   @default("OWNER")
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  code       String
  address    String
  city       String
  phone      String
  email      String
  timezone   String
  status          String   @default("ACTIVE")
  receiptSettings Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees      EmployeeBranch[]
  employeeRoles  EmployeeRole[]
  activities     UserActivity[]
  services       BranchService[]
  propertyAreas  PropertyArea[]
  roomTypes      RoomType[]
  rooms          Room[]
  seatingAreas   SeatingArea[]
  serviceTables  ServiceTable[]
  servicePoints  ServicePoint[]
  beachResources BeachResource[]
  pools          SwimmingPool[]
  eventSpaces    EventSpace[]
  operatingHours OperatingHour[]

  customerNotes  CustomerNote[]
  customerVisits CustomerVisit[]

  // Reservations & Availability
  reservations          Reservation[]
  reservationRooms      ReservationRoom[]
  reservationDeposits   ReservationDeposit[]
  roomBlocks            RoomBlock[]
  reservationHistories  ReservationHistory[]
  reservationWaitlists  ReservationWaitlist[]
  onlineBookingRequests OnlineBookingRequest[]

  // Stays & Folios
  stays                       Stay[]
  stayRoomAssignments         StayRoomAssignment[]
  guestFolios                 GuestFolio[]
  folioEntries                FolioEntry[]
  guestRequests               GuestRequest[]
  stayHistories               StayHistory[]
  CatalogItemBranch           CatalogItemBranch[]
  CatalogItemServicePoint     CatalogItemServicePoint[]
  Menu                        Menu[]
  CatalogAvailabilitySchedule CatalogAvailabilitySchedule[]
  PriceList                   PriceList[]

  orders                      Order[]                       @relation("BranchOrders")
  preparationStations         PreparationStation[]          @relation("BranchPrepStations")
}

model RefreshSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceName       String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  code        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employees       Employee[]
  CatalogCategory CatalogCategory[]
  Menu            Menu[]
}

model Role {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  code         String
  description  String?
  isSystemRole Boolean  @default(false)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  employees   EmployeeRole[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Employee {
  id              String    @id @default(uuid())
  businessId      String
  userId          String?
  departmentId    String?
  employeeCode    String
  fullName        String
  email           String?
  phone           String?
  address         String?
  gender          String?
  dateOfBirth     DateTime?
  jobTitle        String?
  employmentType  String?
  startDate       DateTime?
  profileImageUrl String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branches   EmployeeBranch[]
  roles      EmployeeRole[]
}

model EmployeeBranch {
  id         String   @id @default(uuid())
  employeeId String
  branchId   String
  isPrimary  Boolean  @default(false)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
}

model EmployeeRole {
  id         String   @id @default(uuid())
  employeeId String
  roleId     String
  branchId   String? // If null, implies business-wide role
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, roleId, branchId])
}

model UserActivity {
  id          String   @id @default(uuid())
  businessId  String
  branchId    String?
  userId      String?
  action      String
  resource    String
  resourceId  String?
  description String
  ipAddress   String?
  deviceName  String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchService {
  id          String    @id @default(uuid())
  businessId  String
  branchId    String
  serviceType String // HOTEL, RESTAURANT, BAR, NIGHTCLUB, BEACH, POOL, EVENTS, LOUNGE, SPA, LAUNDRY, ROOM_SERVICE, OTHER
  isEnabled   Boolean   @default(false)
  enabledAt   DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceType])
}

model PropertyArea {
  id           String   @id @default(uuid())
  businessId   String
  branchId     String
  parentAreaId String?
  name         String
  code         String
  areaType     String // Building, Floor, Wing, Section, etc.
  floorLabel   String?
  description  String?
  capacity     Int?
  displayOrder Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parentArea     PropertyArea?   @relation("AreaHierarchy", fields: [parentAreaId], references: [id], onDelete: SetNull)
  childAreas     PropertyArea[]  @relation("AreaHierarchy")
  rooms          Room[]
  seatingAreas   SeatingArea[]
  servicePoints  ServicePoint[]
  beachResources BeachResource[]
  pools          SwimmingPool[]
  eventSpaces    EventSpace[]
  operatingHours OperatingHour[]
}

model RoomType {
  id               String   @id @default(uuid())
  businessId       String
  branchId         String
  name             String
  code             String
  description      String?
  standardCapacity Int      @default(2)
  maximumAdults    Int      @default(2)
  maximumChildren  Int      @default(1)
  bedCount         Int      @default(1)
  bedType          String // Single, Double, Queen, King, Twin, Bunk Bed, Multiple Beds
  basePrice        Float
  currency         String   @default("USD")
  amenities        String? // Stored as JSON string
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rooms    Room[]

  // Reservations
  reservationRooms      ReservationRoom[]
  reservationWaitlists  ReservationWaitlist[]
  onlineBookingRequests OnlineBookingRequest[]
}

model Room {
  id                String   @id @default(uuid())
  businessId        String
  branchId          String
  areaId            String?
  roomTypeId        String
  roomNumber        String
  name              String?
  floorLabel        String?
  basePriceOverride Float?
  maximumGuests     Int?
  operationalStatus String   @default("AVAILABLE") // AVAILABLE, OUT_OF_SERVICE, UNDER_MAINTENANCE, INACTIVE
  occupancyStatus   String   @default("VACANT") // VACANT, OCCUPIED, RESERVED, CHECKOUT_PENDING
  housekeepingStatus String  @default("CLEAN") // CLEAN, DIRTY, INSPECTION
  status            String   @default("ACTIVE")
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area     PropertyArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  roomType RoomType      @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  // Reservations & Availability
  reservationRooms    ReservationRoom[]
  roomBlocks          RoomBlock[]
  stayRoomAssignments StayRoomAssignment[]
  guestRequests       GuestRequest[]

  @@unique([branchId, roomNumber])
}

model SeatingArea {
  id             String   @id @default(uuid())
  businessId     String
  branchId       String
  propertyAreaId String?
  name           String
  description    String?
  serviceType    String // RESTAURANT, BAR, NIGHTCLUB, etc.
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area     PropertyArea?  @relation(fields: [propertyAreaId], references: [id], onDelete: SetNull)
  tables   ServiceTable[]
}

model ServiceTable {
  id               String   @id @default(uuid())
  businessId       String
  branchId         String
  seatingAreaId    String
  name             String
  code             String
  tableType        String // Restaurant Table, Bar Table, VIP Table, Lounge Seat, Cabana Table, Conference Table
  standardCapacity Int      @default(4)
  maximumCapacity  Int      @default(4)
  minimumSpend     Float?
  isReservable     Boolean  @default(true)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  seatingArea SeatingArea @relation(fields: [seatingAreaId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
}

model ServicePoint {
  id                 String   @id @default(uuid())
  businessId         String
  branchId           String
  propertyAreaId     String?
  name               String
  code               String
  serviceType        String // Main Bar, Pool Bar, Beach Bar, Restaurant Cashier, Reception Desk
  canCreateOrders    Boolean  @default(true)
  canReceivePayments Boolean  @default(true)
  canPrintReceipts   Boolean  @default(true)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business                    Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                      Branch                        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area                        PropertyArea?                 @relation(fields: [propertyAreaId], references: [id], onDelete: SetNull)
  CatalogItemServicePoint     CatalogItemServicePoint[]
  MenuServicePoint            MenuServicePoint[]
  CatalogAvailabilitySchedule CatalogAvailabilitySchedule[]
}

model BeachResource {
  id              String   @id @default(uuid())
  businessId      String
  branchId        String
  propertyAreaId  String?
  name            String
  code            String
  resourceType    String // Cabana, Beach Chair, Umbrella, Private Area, VIP Area, Activity Point, Entrance Gate
  capacity        Int      @default(1)
  isReservable    Boolean  @default(true)
  allowsHourlyUse Boolean  @default(true)
  allowsDailyUse  Boolean  @default(true)
  basePrice       Float?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area     PropertyArea? @relation(fields: [propertyAreaId], references: [id], onDelete: SetNull)
}

model SwimmingPool {
  id                String   @id @default(uuid())
  businessId        String
  branchId          String
  propertyAreaId    String?
  name              String
  code              String
  poolType          String // Adult Pool, Children's Pool, Infinity Pool, Private Pool, Training Pool
  maximumCapacity   Int?
  childrenAllowed   Boolean  @default(true)
  lifeguardRequired Boolean  @default(false)
  openingTime       String?
  closingTime       String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area     PropertyArea? @relation(fields: [propertyAreaId], references: [id], onDelete: SetNull)
}

model EventSpace {
  id               String   @id @default(uuid())
  businessId       String
  branchId         String
  propertyAreaId   String?
  name             String
  code             String
  spaceType        String // Conference Hall, Ballroom, Meeting Room, Wedding Venue, Outdoor Event Space, etc.
  standardCapacity Int
  maximumCapacity  Int
  baseRentalPrice  Float?
  isReservable     Boolean  @default(true)
  environmentType  String   @default("INDOOR") // INDOOR, OUTDOOR
  openingTime      String?
  closingTime      String?
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area     PropertyArea? @relation(fields: [propertyAreaId], references: [id], onDelete: SetNull)
}

model OperatingHour {
  id             String   @id @default(uuid())
  businessId     String
  branchId       String
  serviceType    String
  propertyAreaId String?
  dayOfWeek      String // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY
  isClosed       Boolean  @default(false)
  isOpen24Hours  Boolean  @default(false)
  openingTime    String? // HH:mm format
  closingTime    String? // HH:mm format
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area     PropertyArea? @relation(fields: [propertyAreaId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceType, dayOfWeek, propertyAreaId])
}

model Customer {
  id                      String    @id @default(uuid())
  businessId              String
  customerNumber          String
  customerType            String // INDIVIDUAL, WALK_IN, GROUP, CORPORATE, MEMBER
  firstName               String?
  middleName              String?
  lastName                String?
  displayName             String
  phone                   String?
  alternativePhone        String?
  whatsapp                String?
  email                   String?
  gender                  String?
  dateOfBirth             DateTime?
  nationality             String?
  passportNumber          String?
  nationalId              String?
  occupation              String?
  companyName             String?
  photo                   String?
  preferredLanguage       String?
  country                 String?
  city                    String?
  address                 String?
  isVip                   Boolean   @default(false)
  marketingConsent        Boolean   @default(false)
  communicationPreference String?
  status                  String    @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED, MERGED
  mergedIntoCustomerId    String?
  createdByUserId         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business            Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser       User?      @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mergedIntoCustomer  Customer?  @relation("CustomerMerge", fields: [mergedIntoCustomerId], references: [id], onDelete: SetNull)
  mergedFromCustomers Customer[] @relation("CustomerMerge")

  labels                   CustomerLabelAssignment[]
  identifications          CustomerIdentification[]
  preferences              CustomerPreference[]
  notes                    CustomerNote[]
  blocks                   CustomerBlock[]
  visits                   CustomerVisit[]
  groupMemberships         CustomerGroupMember[]
  corporateRepresentatives CorporateRepresentative[]
  timeline                 CustomerTimeline[]
  documents                CustomerDocument[]
  complaints               CustomerComplaint[]
  communications           CustomerCommunication[]
  tags                     CustomerTag[]

  // Reservations
  reservations          Reservation[]
  reservationGuests     ReservationGuest[]
  reservationWaitlists  ReservationWaitlist[]
  onlineBookingRequests OnlineBookingRequest[]

  // Stays & Folios
  stays         Stay[]         @relation("CustomerStays")
  stayOccupants StayOccupant[] @relation("CustomerStayOccupants")
  guestFolios   GuestFolio[]   @relation("CustomerGuestFolios")

  @@unique([businessId, customerNumber])
}

model CustomerLabel {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  code        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business    Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments CustomerLabelAssignment[]

  @@unique([businessId, code])
}

model CustomerLabelAssignment {
  id         String   @id @default(uuid())
  customerId String
  labelId    String
  createdAt  DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label    CustomerLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([customerId, labelId])
}

model CustomerIdentification {
  id                   String    @id @default(uuid())
  businessId           String
  customerId           String
  identificationType   String // Passport, National ID, Driver's License, etc.
  identificationNumber String
  issuingCountry       String?
  issuedAt             DateTime?
  expiresAt            DateTime?
  documentUrl          String?
  status               String    @default("ACTIVE")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerPreference {
  id                    String   @id @default(uuid())
  businessId            String
  customerId            String
  dietaryPreferences    String?
  allergies             String?
  preferredRoomTypeId   String?
  preferredFloor        String?
  bedType               String?
  smokingPreference     String?
  favoriteFood          String?
  favoriteDrink         String?
  favoriteTable         String?
  favoritePoolArea      String?
  favoriteBeachArea     String?
  specialDiet           String?
  notes                 String?
  additionalPreferences String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNote {
  id              String   @id @default(uuid())
  businessId      String
  customerId      String
  branchId        String?
  createdByUserId String?
  category        String // General, Preference, Complaint, Safety, Payment, Behavior, Medical or Allergy, VIP, Other
  content         String
  visibility      String // All Authorized Staff, Management Only, Reception Only
  isImportant     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
