// -----------------------------------------------------------------------------
// Functionality 8: Orders, Prep, & KDS
// -----------------------------------------------------------------------------

model Order {
  id                  String   @id @default(uuid())
  businessId          String
  branchId            String
  orderNumber         String
  orderType           String   // DINE_IN, TAKEAWAY, ROOM_SERVICE, BAR, NIGHTCLUB, BEACH, POOL, EVENT, DELIVERY, COUNTER_SALE
  customerId          String?
  customerGroupId     String?
  corporateAccountId  String?
  stayId              String?
  folioId             String?
  serviceTableId      String?
  beachResourceId     String?
  eventId             String?
  servicePointId      String?
  assignedEmployeeId  String?
  guestCount          Int?
  status              String   @default("OPEN") // DRAFT, OPEN, SENT, IN_PROGRESS, PARTIALLY_READY, READY, PARTIALLY_DELIVERED, DELIVERED, PAYMENT_PENDING, CHARGED_TO_FOLIO, COMPLETED, CANCELLED
  currency            String   @default("USD")
  subtotal            Float    @default(0)
  discountAmount      Float    @default(0)
  estimatedTaxAmount  Float    @default(0)
  serviceChargeAmount Float    @default(0)
  estimatedTotal      Float    @default(0)
  paymentStatus       String   @default("PENDING")
  roomChargeStatus    String   @default("NOT_APPLICABLE")
  openedAt            DateTime @default(now())
  sentAt              DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdByUserId     String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business @relation("BusinessOrders", fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch   @relation("BranchOrders", fields: [branchId], references: [id], onDelete: Cascade)

  rounds              OrderRound[]
  items               OrderItem[]
  history             OrderStatusHistory[]
  tickets             PreparationTicket[]
  occupancies         TableOccupancy[]
  mergesPrimary       OrderMerge[]   @relation("PrimaryOrderMerge")
  mergesMerged        OrderMerge[]   @relation("MergedOrderMerge")
  transfers           OrderTransfer[]
  deliveryConfirmations GuestDeliveryConfirmation[]

  @@unique([businessId, orderNumber])
}

model OrderRound {
  id              String   @id @default(uuid())
  businessId      String
  branchId        String
  orderId         String
  roundNumber     Int
  status          String   @default("DRAFT")
  sentAt          DateTime?
  sentByUserId    String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  tickets PreparationTicket[]

  @@unique([orderId, roundNumber])
}

model OrderItem {
  id                  String   @id @default(uuid())
  businessId          String
  branchId            String
  orderId             String
  orderRoundId        String?
  catalogItemId       String?
  variationId         String?
  itemNameSnapshot    String
  variationNameSnapshot String?
  itemCodeSnapshot    String?
  quantity            Int      @default(1)
  unitPrice           Float
  grossAmount         Float
  discountAmount      Float    @default(0)
  taxAmount           Float    @default(0)
  serviceChargeAmount Float    @default(0)
  netAmount           Float
  preparationRoute    String?  // KITCHEN, BAR, IMMEDIATE, LAUNDRY, etc.
  preparationStationId String?
  status              String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, PREPARING, READY, COLLECTED, DELIVERED, CANCEL_REQUESTED, CANCELLED, VOIDED, RETURNED
  seatNumber          Int?
  billGroupId         String?
  customerNote        String?
  preparationNote     String?
  internalNote        String?
  sentAt              DateTime?
  acceptedAt          DateTime?
  preparingAt         DateTime?
  readyAt             DateTime?
  collectedAt         DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancellationReason  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  round               OrderRound?        @relation(fields: [orderRoundId], references: [id], onDelete: SetNull)
  catalogItem         CatalogItem?       @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  variation           CatalogItemVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  preparationStation  PreparationStation? @relation(fields: [preparationStationId], references: [id], onDelete: SetNull)

  modifiers           OrderItemModifier[]
  history             OrderStatusHistory[]
  ticketItems         PreparationTicketItem[]
}

model OrderItemModifier {
  id                  String   @id @default(uuid())
  orderItemId         String
  modifierGroupId     String?
  modifierOptionId    String?
  groupNameSnapshot   String
  optionNameSnapshot  String
  quantity            Int      @default(1)
  additionalUnitPrice Float    @default(0)
  totalAmount         Float    @default(0)
  createdAt           DateTime @default(now())

  orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierGroup       ModifierGroup? @relation(fields: [modifierGroupId], references: [id], onDelete: SetNull)
  modifierOption      ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id              String   @id @default(uuid())
  businessId      String
  branchId        String
  orderId         String
  orderItemId     String?
  changedByUserId String?
  previousStatus  String
  newStatus       String
  description     String?
  createdAt       DateTime @default(now())

  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model PreparationStation {
  id              String   @id @default(uuid())
  businessId      String
  branchId        String
  servicePointId  String?
  name            String
  code            String
  stationType     String   // KITCHEN, GRILL, FRY, COLD_KITCHEN, DESSERT, BAR, ROOM_SERVICE, BEACH_SERVICE, POOL_SERVICE, LAUNDRY, OTHER
  displayOrder    Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business @relation("BusinessPrepStations", fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch   @relation("BranchPrepStations", fields: [branchId], references: [id], onDelete: Cascade)

  orderItems      OrderItem[]
  tickets         PreparationTicket[]

  @@unique([branchId, code])
}

model PreparationTicket {
  id                  String   @id @default(uuid())
  businessId          String
  branchId            String
  orderId             String
  orderRoundId        String?
  preparationStationId String
  ticketNumber        String
  status              String   @default("NEW") // NEW, ACCEPTED, PREPARING, READY, COMPLETED, CANCELLED
  priority            String   @default("NORMAL") // NORMAL, HIGH, URGENT, VIP
  sentAt              DateTime @default(now())
  acceptedAt          DateTime?
  startedAt           DateTime?
  readyAt             DateTime?
  completedAt         DateTime?
  assignedEmployeeId  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  round               OrderRound?        @relation(fields: [orderRoundId], references: [id], onDelete: SetNull)
  station             PreparationStation @relation(fields: [preparationStationId], references: [id], onDelete: Cascade)

  ticketItems         PreparationTicketItem[]
}

model PreparationTicketItem {
  id                  String   @id @default(uuid())
  preparationTicketId String
  orderItemId         String
  quantity            Int
  status              String   @default("PENDING") // PENDING, PREPARING, READY, CANCELLED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ticket              PreparationTicket @relation(fields: [preparationTicketId], references: [id], onDelete: Cascade)
  orderItem           OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([preparationTicketId, orderItemId])
}

model TableOccupancy {
  id              String   @id @default(uuid())
  businessId      String
  branchId        String
  serviceTableId  String
  orderId         String?
  customerId      String?
  guestCount      Int?
  status          String   @default("OCCUPIED") // OCCUPIED, ORDERING, WAITING_FOR_FOOD, FOOD_READY, DINING, BILL_REQUESTED, CLEANING, AVAILABLE
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  openedByUserId  String?
  closedByUserId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model OrderMerge {
  id              String   @id @default(uuid())
  businessId      String
  primaryOrderId  String
  mergedOrderId   String
  mergedByUserId  String?
  reason          String?
  createdAt       DateTime @default(now())

  primaryOrder    Order    @relation("PrimaryOrderMerge", fields: [primaryOrderId], references: [id], onDelete: Cascade)
  mergedOrder     Order    @relation("MergedOrderMerge", fields: [mergedOrderId], references: [id], onDelete: Cascade)

  @@unique([primaryOrderId, mergedOrderId])
}

model OrderTransfer {
  id                  String   @id @default(uuid())
  businessId          String
  orderId             String
  fromServiceTableId  String?
  toServiceTableId    String?
  transferredByUserId String?
  reason              String?
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model GuestDeliveryConfirmation {
  id                  String   @id @default(uuid())
  businessId          String
  branchId            String
  orderId             String
  stayId              String?
  deliveredByUserId   String?
  recipientName       String?
  signatureData       String?  // Reference to file storage
  guestConfirmed      Boolean  @default(false)
  deliveryNote        String?
  deliveredAt         DateTime @default(now())
  createdAt           DateTime @default(now())

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

