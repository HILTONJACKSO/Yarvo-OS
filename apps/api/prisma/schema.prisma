// FUNCTIONALITY 9: TAXES, PAYMENTS, CASHIER & SETTLEMENTS
// ==============================================================================

model TaxRule {
  id                String   @id @default(uuid())
  businessId        String
  branchId          String?
  name              String
  code              String
  description       String?
  calculationType   String   // PERCENTAGE, FIXED_AMOUNT
  rate              Float?
  fixedAmount       Float?
  priceTreatment    String   // EXCLUSIVE, INCLUSIVE
  appliesToType     String   // ROOM, FOOD, BEVERAGE, ALCOHOL, ALL, etc.
  priority          Int      @default(0)
  isCompounding     Boolean  @default(false)
  effectiveFrom     DateTime?
  effectiveUntil    DateTime?
  displayOnReceipt  Boolean  @default(true)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business          Business @relation("BusinessTaxRules", fields: [businessId], references: [id], onDelete: Cascade)
  assignments       TaxRuleAssignment[]
  transactionTaxes  TransactionTax[]
}

model TaxRuleAssignment {
  id            String   @id @default(uuid())
  taxRuleId     String
  catalogItemId String?
  categoryId    String?
  serviceType   String?
  branchId      String?
  createdAt     DateTime @default(now())

  taxRule       TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
}

model TransactionTax {
  id                      String   @id @default(uuid())
  businessId              String
  branchId                String
  referenceType           String   // ORDER_ITEM, FOLIO_ENTRY
  referenceId             String
  orderItemId             String?
  folioEntryId            String?
  taxRuleId               String?
  taxNameSnapshot         String
  taxCodeSnapshot         String
  rateSnapshot            Float?
  calculationTypeSnapshot String
  priceTreatmentSnapshot  String
  taxableAmount           Float
  taxAmount               Float
  createdAt               DateTime @default(now())

  taxRule                 TaxRule? @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
}

model ServiceChargeRule {
  id                        String   @id @default(uuid())
  businessId                String
  branchId                  String?
  name                      String
  code                      String
  calculationType           String   // PERCENTAGE, FIXED_AMOUNT
  rate                      Float?
  fixedAmount               Float?
  appliesToType             String
  mandatory                 Boolean  @default(true)
  staffDistributionEligible Boolean  @default(false)
  priceTreatment            String   // EXCLUSIVE, INCLUSIVE
  effectiveFrom             DateTime?
  effectiveUntil            DateTime?
  displayOnReceipt          Boolean  @default(true)
  status                    String   @default("ACTIVE")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  business                  Business @relation("BusinessServiceChargeRules", fields: [businessId], references: [id], onDelete: Cascade)
}

model Payment {
  id                  String   @id @default(uuid())
  businessId          String
  branchId            String
  paymentNumber       String
  customerId          String?
  corporateAccountId  String?
  stayId              String?
  folioId             String?
  orderId             String?
  cashierShiftId      String?
  paymentMethod       String   // CASH, MOBILE_MONEY, DEBIT_CARD, CREDIT_CARD, BANK_TRANSFER, CORPORATE_CREDIT, GUEST_FOLIO, VOUCHER, COMPLIMENTARY, OTHER
  provider            String?
  amount              Float
  currency            String   @default("USD")
  baseCurrency        String   @default("USD")
  exchangeRate        Float    @default(1.0)
  baseAmount          Float
  amountTendered      Float?
  changeGiven         Float?
  referenceNumber     String?
  status              String   @default("CONFIRMED") // PENDING, AUTHORIZED, CONFIRMED, PARTIALLY_REFUNDED, REFUNDED, FAILED, VOIDED, REVERSED
  receivedFrom        String?
  receivedByUserId    String?
  confirmedByUserId   String?
  receivedAt          DateTime @default(now())
  confirmedAt         DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  allocations         PaymentAllocation[]
  refunds             Refund[]
  receipts            Receipt[]

  @@unique([businessId, paymentNumber])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  referenceType   String   // ORDER, FOLIO, INVOICE
  referenceId     String
  allocatedAmount Float
  createdAt       DateTime @default(now())

  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Settlement {
  id                  String   @id @default(uuid())
  businessId          String
  branchId            String
  settlementNumber    String
  referenceType       String   // ORDER, FOLIO
  referenceId         String
  currency            String   @default("USD")
  subtotal            Float
  discountAmount      Float    @default(0)
  taxAmount           Float    @default(0)
  serviceChargeAmount Float    @default(0)
  totalAmount         Float
  paidAmount          Float    @default(0)
  balanceAmount       Float
  status              String   // UNPAID, PARTIALLY_PAID, PAID, OVERPAID, REFUNDED, VOIDED
  settledAt           DateTime?
  settledByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  receipts            Receipt[]

  @@unique([businessId, settlementNumber])
}

model Refund {
  id                String   @id @default(uuid())
  businessId        String
  branchId          String
  refundNumber      String
  paymentId         String
